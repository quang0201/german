{
  "name": "german-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "bun test",
    "styles": "bunx @tailwindcss/cli -i ./src/styles.css -o ./src/tailwind.css --minify",
    "build": "bun run styles && bun build ./index.html --outdir ./dist --production --public-path /",
    "build:api": "bun run build && bun ./scripts/copy-to-api.js"
  },
  "dependencies": {
    "@tailwindcss/cli": "4.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.0"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
